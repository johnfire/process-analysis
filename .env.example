# Copy to .env on the VPS (/opt/process-analysis/.env). Never commit the real file.
# POSTGRES_PASSWORD: generate with `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=process_analysis
POSTGRES_USER=process_analysis
APP_PORT=8110
LOG_LEVEL=INFO
# Outgoing mail for invitations and password resets (same SMTP account as flashkarte).
# Leave MAIL_HOST empty to run without mail: invitation links are then shown on screen.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=1
