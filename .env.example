# Copy to .env on the VPS (/opt/process-analysis/.env). Never commit the real file.
# POSTGRES_PASSWORD: generate with `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=process_analysis
POSTGRES_USER=process_analysis
APP_PORT=8110
LOG_LEVEL=INFO
# Outgoing mail for invitations and password resets (same SMTP account as flashkarte).
# Leave MAIL_HOST empty to run without mail: invitation links are then shown on screen.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=1

# Model providers for extraction. Keys go to the worker only, never the web container.
# PROVIDERS_ENABLED: comma-separated, from: openrouter, deepseek, anthropic, openai
# SENSITIVE_OK_PROVIDERS: the subset you have verified (read their data-retention terms yourself)
# is acceptable for sensitive clients. Empty means sensitive clients cannot use any provider.
PROVIDERS_ENABLED=
SENSITIVE_OK_PROVIDERS=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
